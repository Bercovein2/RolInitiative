<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:id="@+id/layoutTitleFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/buttonFolderClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_alignParentStart="true"
            android:src="@drawable/ic_button_close"
            android:background="@null"
            android:contentDescription="@string/close_folders"/>

        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/myFolders"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"
            android:layout_marginTop="16dp"/>

        <ImageButton
            android:id="@+id/buttonFolderCreate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_plus"
            android:background="@null"
            android:contentDescription="@string/add_folders"/>
    </RelativeLayout>

    <ExpandableListView
        android:id="@+id/expandableListViewFoldersCharacters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:dividerHeight="2dp"
        android:textColor="@color/white"/>

    <!-- TextView que se mostrará cuando el ExpandableListView esté vacío -->
    <TextView
        android:id="@+id/textViewEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create a folder with + button"
        android:textColor="@android:color/darker_gray"
        android:visibility="gone"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:id="@+id/layoutNameFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editTextNameFolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:maxLines="1"
            android:maxLength="50"
            android:hint="@string/enterName"
            android:autofillHints="name"
            android:inputType="textCapWords"
            android:imeOptions="actionNext"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutFolders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp">

        <EditText
            android:id="@+id/editTextArmorClassFolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:hint="@string/enterArmorClass"
            android:autofillHints="CA"
            android:inputType="number|numberSigned"
            android:imeOptions="actionNext"/>

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/editTextLifeFolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="16sp"
            android:hint="@string/enterLife"
            android:autofillHints="life"
            android:inputType="number|numberSigned"
            android:imeOptions="actionNext"/>
    </LinearLayout>

    <!-- Multi-Selection Dropdown for Folders -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/folderSelector"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_gravity="center_vertical"/>

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content" />
        <Spinner
            android:id="@+id/spinnerFolders"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:padding="3dp"
            android:textSize="16sp"
            android:background="@drawable/spinner_background"
            android:layout_gravity="center_vertical"
            android:spinnerMode="dropdown"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/buttonFolderAdd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeStepGranularity="1sp"
            android:padding="8dp"
            android:maxLines="1"
            android:text="@string/add" />

        <ImageButton
            android:id="@+id/buttonDeleteFromFolder"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:padding="10dp"
            android:backgroundTint="@color/darkRed"
            android:background="@drawable/round_button_background"
            android:src="@drawable/ic_trash"
            android:scaleType="centerInside"
            android:contentDescription="@string/delete_characters_from_database"
            />

        <Button
            android:id="@+id/buttonFolderSendToFight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeStepGranularity="1sp"
            android:padding="8dp"
            android:maxLines="1"
            android:layout_margin="8dp"
            android:text="@string/addToFight"/>
    </LinearLayout>
</LinearLayout>
